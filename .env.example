# Copy to .env and set real values locally. Never commit .env or secrets.

# Environment
ENVIRONMENT=development

# Database (default is local SQLite)
DATABASE_URL=sqlite:///./trading_bot.db

# Binance API (Testnet credentials only for this project; leave empty if unused)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true

# Trading safety - keep live trading disabled
LIVE_TRADING_ENABLED=false

# Admin token for protected bot management endpoints (set a strong random value locally)
BOT_ADMIN_TOKEN=
