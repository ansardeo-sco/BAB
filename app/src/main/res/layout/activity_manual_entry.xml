<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtManualTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Manual Entry"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtManualModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/bg_input"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="LIMIT ONLY"
                android:textColor="@color/accent_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxEntryForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Stage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stage"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spStageSelect"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.35"
                    android:background="@color/bg_input"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp" />
            </LinearLayout>

            <!-- Symbol -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Symbol"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <AutoCompleteTextView
                    android:id="@+id/actvSymbol"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.35"
                    android:background="@color/bg_input"
                    android:completionThreshold="1"
                    android:hint="BTCUSDT"
                    android:inputType="textCapCharacters"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Live Price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Live Price"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLivePrice"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.35"
                    android:background="@color/bg_input"
                    android:ellipsize="end"
                    android:gravity="center_vertical|end"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtLivePriceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:text=""
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <!-- Entry Price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Entry Price"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEntryPrice"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.35"
                    android:background="@color/bg_input"
                    android:gravity="start|center_vertical"
                    android:hint="LIMIT price"
                    android:inputType="numberDecimal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Margin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Margin (USDT)"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEntryMargin"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.35"
                    android:background="@color/bg_input"
                    android:gravity="start|center_vertical"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="2.0"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Leverage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Leverage"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spEntryLeverage"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.35"
                    android:background="@color/bg_input"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trade Preview -->
        <LinearLayout
            android:id="@+id/boxEntrySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trade Preview"
                android:textColor="@color/accent_yellow"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPreviewContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="--"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenLong"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_long_rounded"
                android:backgroundTint="@null"
                android:text="Open Long"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenShort"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_short_rounded"
                android:backgroundTint="@null"
                android:text="Open Short"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtManualResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Hidden/compatibility views referenced by older code paths -->
        <LinearLayout
            android:id="@+id/boxStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/txtStatsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtStats24h" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtStats7d" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtStatsRsi" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtStatsDist" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/txtPriceNote" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <Spinner android:id="@+id/spEntrySymbol" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
