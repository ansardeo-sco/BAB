<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtDetailSymbol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BTCUSDT"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnFavoriteToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_input"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="★ Favorite"
                    android:textColor="@color/accent_yellow"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtDetailStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Loading..."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Market Price"
                    android:textColor="@color/accent_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMarkPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="24h Change: --"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Last update: --"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Market Statistics"
                    android:textColor="@color/accent_yellow"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStatsState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Loading statistics..."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:stretchColumns="1,2,3">

                    <TableRow>
                        <TextView android:text="Period" android:textColor="@color/text_muted" android:textStyle="bold" android:padding="4dp" />
                        <TextView android:text="High" android:textColor="@color/text_muted" android:textStyle="bold" android:padding="4dp" android:gravity="end" />
                        <TextView android:text="Low" android:textColor="@color/text_muted" android:textStyle="bold" android:padding="4dp" android:gravity="end" />
                        <TextView android:text="RSI" android:textColor="@color/text_muted" android:textStyle="bold" android:padding="4dp" android:gravity="end" />
                    </TableRow>

                    <TableRow>
                        <TextView android:text="1 Week (7 Days)" android:textColor="@color/text_primary" android:padding="4dp" />
                        <TextView android:id="@+id/txtHigh7d" android:text="--" android:textColor="@color/text_primary" android:padding="4dp" android:gravity="end" android:fontFamily="monospace" />
                        <TextView android:id="@+id/txtLow7d" android:text="--" android:textColor="@color/text_primary" android:padding="4dp" android:gravity="end" android:fontFamily="monospace" />
                        <TextView android:id="@+id/txtRsi7d" android:text="--" android:textColor="@color/text_primary" android:padding="4dp" android:gravity="end" />
                    </TableRow>

                    <TableRow>
                        <TextView android:text="24 Hours" android:textColor="@color/text_primary" android:padding="4dp" />
                        <TextView android:id="@+id/txtHigh24h" android:text="--" android:textColor="@color/text_primary" android:padding="4dp" android:gravity="end" android:fontFamily="monospace" />
                        <TextView android:id="@+id/txtLow24h" android:text="--" android:textColor="@color/text_primary" android:padding="4dp" android:gravity="end" android:fontFamily="monospace" />
                        <TextView android:id="@+id/txtRsi24h" android:text="--" android:textColor="@color/text_primary" android:padding="4dp" android:gravity="end" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:id="@+id/txtRsiMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="RSI: 24h = RSI(14) Wilder on 1h closes; 7d = RSI(14) Wilder on 4h closes (index value)."
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Additional Market Info"
                    android:textColor="@color/accent_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/txtVol24h" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="24h Trading Volume: --" android:textColor="@color/text_primary" android:textSize="13sp" />
                <TextView android:id="@+id/txtDist24h" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Distance from current to 24h High/Low: --" android:textColor="@color/text_primary" android:textSize="13sp" />
                <TextView android:id="@+id/txtDist7d" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Distance from current to 7d High/Low: --" android:textColor="@color/text_primary" android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Statistics use actual Binance USDⓈ-M public market data to help assess recent price movement before entering a trade."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/bg_input"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnTradeNow"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_yellow"
            android:text="Trade Now"
            android:textAllCaps="false"
            android:textColor="@color/bg_primary"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
